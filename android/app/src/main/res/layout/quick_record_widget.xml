<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center" android:padding="4dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_sleep" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp" android:contentDescription="@string/widget_sleep_description" android:importantForAccessibility="yes">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/baby_face_sweet" android:scaleType="fitXY" android:cropToPadding="true" android:background="@drawable/widget_face_clip" android:importantForAccessibility="no" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/widget_sleep" android:textSize="13sp" android:textColor="#263329" android:maxLines="1" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_feeding" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp" android:contentDescription="@string/widget_feeding_description" android:importantForAccessibility="yes">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/baby_face_smile" android:scaleType="fitXY" android:cropToPadding="true" android:background="@drawable/widget_face_clip" android:importantForAccessibility="no" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/widget_feeding" android:textSize="13sp" android:textColor="#263329" android:maxLines="1" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_temperature" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp" android:contentDescription="@string/widget_temperature_description" android:importantForAccessibility="yes">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/baby_face_cry" android:scaleType="fitXY" android:cropToPadding="true" android:background="@drawable/widget_face_clip" android:importantForAccessibility="no" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/widget_temperature" android:textSize="13sp" android:textColor="#263329" android:maxLines="1" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_diaper" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="2dp" android:contentDescription="@string/widget_diaper_description" android:importantForAccessibility="yes">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/baby_face_pout" android:scaleType="fitXY" android:cropToPadding="true" android:background="@drawable/widget_face_clip" android:importantForAccessibility="no" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/widget_diaper" android:textSize="13sp" android:textColor="#263329" android:maxLines="1" android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
